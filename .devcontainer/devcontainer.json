{
  "name": "agent-server",
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.dev.yml"],
  "service": "app",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "astral-sh.ty",
        "ms-python.python",
        "ms-python.debugpy"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
